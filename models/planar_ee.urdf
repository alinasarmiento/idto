<?xml version="1.0" encoding="utf-8"?>

<robot name="ee">
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </visual>
  </link>
  
  <link name="ee">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1.6e-5" ixy="0" ixz="0" iyy="1.6e-5" iyz="0" izz="1.6e-5"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </visual>

    <collision name="collision">
      <origin rpy="0 0 0" xyz="0 0 0.0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <drake:proximity_properties>
	<drake:rigid_hydroelastic/>
        <drake:mesh_resolution_hint value="0.06"/>
	<drake:mu_static value="1.0"/>
        <drake:mu_dynamic value="1.0"/>
      </drake:proximity_properties>
    </collision>    
  </link>

  <joint name="ee_x" type="prismatic">
    <parent link="base_link"/>
    <child link="ee"/>
    <axis xyz="1 0 0"/>
    <!-- <limit effort="10" lower="0.0" upper="0.7" velocity="10"/> -->
  </joint>

  <transmission name="ee_x">
    <type> transmission_interface/SimpleTransmission</type>
    <joint name="ee_x"/>
    <!--   <hardwareInterface>EffortJointInterface</hardwareInterface> -->
    <!-- </joint> -->
    <actuator name="x_motor"/>
    <!--   <hardwareInterface>EffortJointInterface</hardwareInterface> -->
    <!-- </actuator> -->
    <mechanicalReduction>1</mechanicalReduction>
  </transmission>

</robot>
