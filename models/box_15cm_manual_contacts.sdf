          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0020625</iyy>
          <iyz>0</iyz>
          <izz>0.0020625</izz>
        </inertia>
      </inertial>

      <visual name="box_visual">
        <geometry>
          <box>
            <size>0.15 0.15 0.15</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 0 0 0.8</diffuse>
        </material>
      </visual>

